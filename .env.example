# Copy to .env. See docs/SELF_HOSTING.md for where to get each value.

# === REQUIRED EVERYWHERE ===
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# === PLATFORM ===
# linkedin (default) or threads
PLATFORM=linkedin

# === REQUIRED IN PRODUCTION (ENV=production, incl. both docker compose files) ===
# Local `scripts/manual_run.py` uses mock APIs when these are empty.

# LinkedIn API — OAuth 2.0 at https://developer.linkedin.com
# Scope: w_member_social (posting on behalf of the member)
# 1. Create app at https://developer.linkedin.com/apps
# 2. Add Products → Share on LinkedIn (grants w_member_social)
# 3. OAuth 2.0 flow: exchange code for access token
# 4. GET https://api.linkedin.com/v2/userinfo → sub = person ID
LINKEDIN_ACCESS_TOKEN=

# Author URN, e.g. urn:li:person:123456789 (from /v2/userinfo sub field)
LINKEDIN_AUTHOR_URN=

# LinkedIn API version (YYYYMM format)
LINKEDIN_VERSION=202411

# Threads API (publishing + metrics) — long-lived token, auto-refreshed weekly
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=

# Telegram bot (OPTIONAL — approval flow can be CLI via manual_run.py)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_URL=https://agent.your-domain.com
TELEGRAM_WEBHOOK_SECRET=

# Apify (Threads scraping for viral content discovery)
# Get from: https://console.apify.com/account/integrations
APIFY_API_TOKEN=

# Postgres (used by docker-compose.prod.yml; docker-compose.yml has dev defaults)
POSTGRES_USER=agent
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agent_db

# === OPTIONAL ===
# Protects /api/* endpoints (header X-API-Key). Without it they return 503 in production.
API_SECRET_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=autoviralai
ACCOUNT_ID=default
TARGET_FOLLOWERS=0

# NOTE: ENV and POSTGRES_URI are set by the docker compose files
